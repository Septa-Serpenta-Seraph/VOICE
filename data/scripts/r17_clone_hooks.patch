+_R17_VC_MS = None      # fixed VC duration_ms override
+_R17_PROP_TRANS = False  # proportional transition budget (the candidate fix)
+
+
+def prop_written_ms(vowel_dur_ms, cap_ms):
+    """Written transition extent (ms) for a vowel of given duration.
+
+    Rule: each transition may tax at most 25% of the vowel, floored at 30ms
+    written (2 glide frames + 1 steady) and capped at the legacy budget
+    (60 CV / 50 VC). Long vowels (>=240ms CV, >=200ms VC) keep the legacy
+    extent exactly, so phrase-final lengthened nuclei are untouched.
+    The producer adds one steady-state frame (+10ms written), so the
+    requested duration_ms is the written extent minus 10.
+    """
+    w = min(cap_ms, max(30, int(0.25 * vowel_dur_ms / 10) * 10))
+    return w
+
 
