+def transition_written_ms(vowel_dur_ms, cap_ms):
+    """Written CV/VC transition extent (ms) for a vowel of given duration.
+
+    Round 17: each transition may tax at most 25% of the adjacent vowel,
+    floored at 30ms written (2 glide frames + 1 steady) and capped at the
+    legacy budget (60 CV / 50 VC). Vowels >= 240ms (CV) / >= 200ms (VC)
+    keep the legacy extent exactly, so phrase-final lengthened nuclei are
+    untouched. The producer adds one steady-state frame (+10ms written),
+    so the requested duration_ms is the written extent minus 10.
+    Verified: golden WER 0.778 -> 0.462 (2/4), 'She sees the sun.' exact;
+    held-out still 0/5 (the next wall). Guard: tests/test_steady_state_fraction.py.
+    """
+    return min(cap_ms, max(30, int(0.25 * vowel_dur_ms / 10) * 10))
+
